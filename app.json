{
  "expo": {
    "name": "endzone",
    "slug": "endzone",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "endzone",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "io.github.carloshgalvan95.endzone",
      "supportsTablet": true
    },
    "android": {
      "package": "io.github.carloshgalvan95.endzone",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#1B1F23"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1F23",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidAbiSplits",
      [
        "expo-notifications",
        {
          "color": "#1B1F23"
        }
      ],
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextGame",
              "label": "endzone",
              "description": "Next game from the model",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "160dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ]
  }
}
