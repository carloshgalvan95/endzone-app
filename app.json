{
  "expo": {
    "name": "endzone",
    "slug": "endzone",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "endzone",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "io.github.carloshgalvan95.endzone",
      "supportsTablet": true
    },
    "android": {
      "package": "io.github.carloshgalvan95.endzone",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1B1F23"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1F23",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidAbiSplits",
      [
        "expo-notifications",
        {
          "color": "#1B1F23"
        }
      ]
    ]
  }
}
